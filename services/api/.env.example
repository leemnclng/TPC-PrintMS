# Copy this file to .env. Change only PRINT_MS_STAGE when switching between
# isolated development, test, and production data, then restart the app.
PRINT_MS_STAGE=development
PRINT_MS_DATA_DIR=.data
PRINT_MS_DEVELOPMENT_DATABASE_PATH=.data/development/printing-ms.db
PRINT_MS_TEST_DATABASE_PATH=.data/test/printing-ms.db
PRINT_MS_PRODUCTION_DATABASE_PATH=.data/production/printing-ms.db

# Backwards compatibility only: when set, this overrides the active stage's
# path above. Prefer the three explicit stage paths for new installations.
# PRINT_MS_DATABASE_PATH=.data/development/one-off.db

# auto (recommended), windows, macos, or linux
PRINT_MS_PRINTER_PLATFORM=auto

# DEBUG logs every backend request; INFO records startup phases, slow requests,
# shutdown, and crashes. Logs rotate under .data/<stage>/logs/backend.log.
PRINT_MS_LOG_LEVEL=INFO
