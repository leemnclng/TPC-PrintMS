{
  "name": "@printing-ms/desktop",
  "private": true,
  "version": "0.1.0",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc -b && electron dist/main.js",
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "package": "tsc -b && electron-builder"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.9.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "com.thepaperclub.printingms",
    "productName": "Printing-MS",
    "files": [
      "dist/**/*",
      "build/icon.png",
      "../web/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/windows_scan.ps1",
        "to": "scanner/windows_scan.ps1"
      },
      {
        "from": "../../services/api",
        "to": "backend",
        "filter": ["!.venv", "!__pycache__", "!**/__pycache__/**"]
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "target": "dmg"
    },
    "win": {
      "icon": "build/icon.png",
      "target": "nsis"
    }
  }
}
